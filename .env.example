# =============================================================================
# DHARMA ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and customize the values for your environment
# This file contains all the secrets and configuration needed to run Dharma

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=dharma
POSTGRES_PASSWORD=dharma_dev_password_change_in_production
POSTGRES_DB=dharma
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full database URL for SQLAlchemy (constructed from above values)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Connection pool of each API and worker process
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# Also the Celery broker and result backend
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
# How long the API waits for Redis before treating it as down (seconds)
# REDIS_TIMEOUT_SECONDS=1

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PORT=8000
FRONTEND_PORT=5173

# JWT Secret for authentication (generate a secure random string in production)
JWT_SECRET_KEY=dharma_jwt_secret_key_change_in_production_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
# Access tokens are short-lived; the web client renews them with the refresh token
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
# Anything other than development/dev/local/test needs a private JWT_SECRET_KEY
ENVIRONMENT=development
# /docs, /redoc and /openapi.json are served in development only; true serves them elsewhere too
# ENABLE_DOCS=false
# Largest request body the API accepts, in bytes
# MAX_REQUEST_BODY_BYTES=1048576

# =============================================================================
# EXTERNAL SERVICES (Optional - for advanced features)
# =============================================================================

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET=dharma-uploads

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Dharma
VITE_APP_DESCRIPTION="The Underground Network for Sneaker Culture"

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Grafana admin password ("make setup" writes a random one). Grafana and Prometheus listen on 127.0.0.1 only.
GRAFANA_ADMIN_PASSWORD=admin
SENTRY_DSN=
TRACES_SAMPLE_RATE=0.1
PROFILES_SAMPLE_RATE=0.1

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# DEMO DATA SETTINGS
# =============================================================================
# Set to true to automatically seed demo data on first run
AUTO_SEED_DATA=true

# Number of demo users to create
DEMO_USERS_COUNT=50

# Number of demo posts to create
DEMO_POSTS_COUNT=200

# Number of demo releases to create
DEMO_RELEASES_COUNT=10
