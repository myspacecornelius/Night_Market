{
  "name": "Night Market",
  // Python for the API and worker; Node for the web client; Docker for Postgres/PostGIS,
  // Redis and the rest of the stack (`make up`).
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "Makefile"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  // `make setup` writes .env with a private JWT secret instead of copying the published example.
  "postCreateCommand": "make setup && pip install -r requirements.txt && npm --prefix frontend ci",
  "forwardPorts": [5173, 8000]
}
